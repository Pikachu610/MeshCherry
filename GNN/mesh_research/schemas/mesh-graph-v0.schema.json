{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-graph-v0",
  "type": "object",
  "required": ["schema_version", "nodes", "interfaces"],
  "properties": {
    "schema_version": {"type": "string", "const": "mesh-graph-v0"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cell_id", "area", "centroid"],
        "properties": {
          "cell_id": {"type": "string"},
          "area": {"type": "number"},
          "centroid": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "number"}
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["interface_id", "cell_ids", "length"],
        "properties": {
          "interface_id": {"type": "string"},
          "cell_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "length": {"type": "number"}
        }
      }
    },
    "directed_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "interface_id"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "interface_id": {"type": "string"}
        }
      }
    }
  }
}
