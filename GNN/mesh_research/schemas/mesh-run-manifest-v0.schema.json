{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-run-manifest-v0",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_name",
    "created_at",
    "inputs",
    "crs",
    "units",
    "generator",
    "domain",
    "artifact_hashes",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "mesh-run-manifest-v0"},
    "run_id": {"type": "string"},
    "run_name": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "logical_path", "sha256"],
        "properties": {
          "role": {"type": "string"},
          "logical_path": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    },
    "crs": {"type": ["string", "null"]},
    "units": {
      "type": "object",
      "required": ["coordinate", "state"],
      "properties": {
        "coordinate": {"type": ["string", "null"]},
        "state": {"type": ["object", "null"]}
      }
    },
    "generator": {
      "type": ["object", "null"],
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "domain": {
      "type": ["object", "null"],
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"}
      }
    },
    "artifact_hashes": {"type": "object"},
    "boundary": {"type": "object"},
    "status": {"type": "string"}
  }
}
