{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic-matrix-summary-v0",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_id",
    "created_at",
    "source_config",
    "source_config_sha256",
    "status",
    "runs"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "synthetic-matrix-summary-v0"},
    "matrix_id": {"type": "string"},
    "created_at": {"type": "string"},
    "source_config": {"type": "string"},
    "source_config_sha256": {"type": "string"},
    "status": {"type": "string"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain", "refinement", "target_edge", "status"],
        "properties": {
          "domain": {"type": "string"},
          "refinement": {"type": "string"},
          "target_edge": {"type": "number"},
          "status": {"type": "string"}
        }
      }
    }
  }
}
