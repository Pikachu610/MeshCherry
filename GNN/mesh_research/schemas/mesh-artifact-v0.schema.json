{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-artifact-v0",
  "type": "object",
  "required": ["schema_version", "crs", "coordinate_units", "vertices", "triangles"],
  "properties": {
    "schema_version": {"type": "string", "const": "mesh-artifact-v0"},
    "crs": {"type": "string"},
    "coordinate_units": {"type": "string"},
    "vertices": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {"type": "number"}
      }
    },
    "triangles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "items": {"type": "integer"}
      }
    }
  }
}
