{
  "schema_version": "mesh-matrix-config-v0",
  "matrix_kind": "roi4_resolution_sweep",
  "run_name": "gmsh-roi4-resolution-sweep",
  "generator": {
    "name": "gmsh",
    "version": "auto",
    "executable": "../../Test_chialuoi/gmsh-4.15.2-Windows64/gmsh.exe",
    "parameters": {
      "algorithm": 5,
      "random_seed": 1
    }
  },
  "domains": [
    {
      "name": "ROI4",
      "kind": "roi_boundary",
      "boundary_source": "../../../ROI/ROI4.shp",
      "simplification": {
        "method": "rdp_closed_ring",
        "tolerances": [10.0, 25.0, 50.0, 100.0, 200.0, 500.0],
        "max_relative_area_difference": 0.005,
        "max_hausdorff_distance": 250.0,
        "hausdorff_sampling_interval": 25.0
      }
    }
  ],
  "refinements": [
    {"name": "250m", "target_edge": 250.0},
    {"name": "500m", "target_edge": 500.0},
    {"name": "1000m", "target_edge": 1000.0}
  ],
  "semantic_evidence": {
    "status": "not_available",
    "audit": [
      {
        "candidate": "GNN/mesh_research/fixtures/rasters/*.json",
        "status": "rejected",
        "reason": "Synthetic ticket-04 fixtures are not ROI4 field evidence."
      },
      {
        "candidate": "feature/FINAL_BUFFER_30M/*.tif",
        "status": "rejected",
        "reason": "Recorded ArcGIS lineage uses ROI/ROI.shp rather than the canonical ROI/ROI4.shp source."
      },
      {
        "candidate": "Precipitation/**/*.tif and other workspace rasters",
        "status": "unverified",
        "reason": "Canonical ROI4 derivation, quantity semantics and reproducible support by the current remapper are not jointly established."
      }
    ]
  },
  "crs": "EPSG:32649",
  "coordinate_units": "m",
  "state_units": {
    "volume": "m3",
    "depth": "m"
  },
  "output_root": "../mesh_runs"
}
